---
import ViewCounter from "./ViewCounter.astro";
import { EMAIL, GITHUB_URL, LINKEDIN_URL } from "@/data/contact";

const links = [
  { href: `mailto:${EMAIL}`, label: "Email" },
  { href: "/David_Swan_Resume.pdf", label: "Résumé" },
  { href: LINKEDIN_URL, label: "LinkedIn" },
  { href: GITHUB_URL, label: "GitHub" },
];
---

<footer class="p-4 text-sm text-ink-faint md:p-6">
  <p class="flex flex-wrap gap-x-2 gap-y-1">
    {links.map(({ href, label }, i) => (
      <>
        {i > 0 && <span aria-hidden="true">·</span>}
        <a href={href} class="transition-colors hover:text-ink">
          {label}
        </a>
      </>
    ))}
  </p>
  <p class="mt-2">© {new Date().getFullYear()} David Swan</p>
  <ViewCounter />
</footer>
