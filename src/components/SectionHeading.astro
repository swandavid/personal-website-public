---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<h2 class="section-heading">{title}</h2>

<script>
  // Mark a heading while it is stuck to the top of the viewport. The -1px
  // top margin makes a stuck heading read as not fully visible.
  function init() {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const { target, intersectionRatio, boundingClientRect } of entries)
          target.toggleAttribute(
            "data-stuck",
            intersectionRatio < 1 && boundingClientRect.top < 1,
          );
      },
      { rootMargin: "-1px 0px 0px 0px", threshold: 1 },
    );
    document
      .querySelectorAll(".section-heading")
      .forEach((h) => observer.observe(h));
    document.addEventListener(
      "astro:before-swap",
      () => observer.disconnect(),
      {
        once: true,
      },
    );
  }
  document.addEventListener("astro:page-load", init);
</script>
