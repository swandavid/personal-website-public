---
import { getCollection } from "astro:content";
import { Image, getImage } from "astro:assets";
import { ArrowRight, ArrowUpRight, ExternalLink } from "lucide-react";
import SectionHeading from "./SectionHeading.astro";
import projectData from "@/data/projects.json";

// Collections come back sorted by id; show them in the order of the JSON file.
const position = (id: string) => projectData.findIndex((p) => p.id === id);
const projects = (await getCollection("projects")).sort(
  (a, b) => position(a.id) - position(b.id),
);
const posters = new Map(
  await Promise.all(
    projects
      .filter((p) => p.data.video)
      .map(async (p) => {
        const img = await getImage({ src: p.data.image, width: 600 });
        return [p.id, img.src] as const;
      }),
  ),
);
---

<section id="projects" class="mb-16 md:mb-24">
  <SectionHeading title="Projects" />
  {projects.map(({ id, data: proj }) => (
    <div class="card group mb-6 md:mb-8">
      <div class="flex flex-col-reverse gap-6 md:flex-row">
        <div class="flex items-center justify-center md:w-1/3">
          <div class="w-full overflow-hidden md:max-w-[18.75rem] rounded-lg border border-edge transition-[border-color,box-shadow] duration-300 group-hover:border-ink-faint/40 group-hover:shadow-lg">
            {proj.video ? (
              <a href={proj.projectUrl} tabindex="-1" aria-hidden="true">
                <video
                  data-loop
                  src={proj.video}
                  poster={posters.get(id)}
                  muted
                  loop
                  playsinline
                  preload="none"
                  class="aspect-[16/10] h-auto w-full object-cover transition-transform duration-500 ease-out-soft group-hover:scale-[1.02]"
                />
              </a>
            ) : (
              <Image
                src={proj.image}
                alt={`Screenshot of ${proj.name}`}
                width={600}
                class="h-auto w-full object-cover transition-transform duration-500 ease-out-soft group-hover:scale-[1.02]"
              />
            )}
          </div>
        </div>
        <div class="flex flex-col justify-between md:w-2/3">
          <div>
            <div class="mb-2 flex items-center justify-between md:mb-4">
              {proj.projectUrl ? (
                <a
                  href={proj.projectUrl}
                  class="link-arrow text-base font-semibold md:text-lg"
                >
                  <span>{proj.name}</span>
                  {proj.projectUrl.startsWith("/") ? (
                    <ArrowRight className="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
                  ) : (
                    <ExternalLink className="h-4 w-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
                  )}
                </a>
              ) : (
                <span class="text-base font-semibold text-ink md:text-lg">
                  {proj.name}
                </span>
              )}
              {proj.role && <span class="label">{proj.role}</span>}
            </div>
            <p class="mb-4 text-sm leading-relaxed text-ink-faint md:mb-6 md:text-base">
              {proj.description}
            </p>
            {proj.sourceUrl && (
              <a href={proj.sourceUrl} class="link-arrow mb-4 text-sm md:mb-6">
                View source
                <ArrowUpRight className="h-4 w-4" aria-hidden="true" />
              </a>
            )}
          </div>
          {proj.technologies && (
            <div class="mt-auto flex flex-wrap gap-2 md:gap-3">
              {proj.technologies.map((tech) => (
                <span class="tag">{tech}</span>
              ))}
            </div>
          )}
        </div>
      </div>
    </div>
  ))}
</section>

<script>
  // Play project loops only while on screen, and not at all for visitors who
  // ask for reduced motion (they get the poster).
  function init() {
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const observer = new IntersectionObserver((entries) => {
      for (const { target, isIntersecting } of entries) {
        const video = target as HTMLVideoElement;
        if (isIntersecting) video.play().catch(() => {});
        else video.pause();
      }
    });
    document
      .querySelectorAll<HTMLVideoElement>("video[data-loop]")
      .forEach((v) => observer.observe(v));
    document.addEventListener(
      "astro:before-swap",
      () => observer.disconnect(),
      { once: true },
    );
  }
  document.addEventListener("astro:page-load", init);
</script>
